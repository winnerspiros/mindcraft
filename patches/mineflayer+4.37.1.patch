+// 26.3 PLAYER-ACTION ORDINALS. Mineflayer's bare 0/1/2 literals were correct
+// for vanilla, but 26.3 inserts CHANGE_DESTROY_DIRECTION at index 1, which
+// shifts ABORT and STOP. Verified against the server jar we actually run,
+// /home/ubuntu/kenoi-fabric/versions/26.3/server-26.3.jar, by decompiling
+// ServerboundPlayerActionPacket$Action.<clinit>:
+//     0 START_DESTROY_BLOCK    1 CHANGE_DESTROY_DIRECTION
+//     2 ABORT_DESTROY_BLOCK    3 STOP_DESTROY_BLOCK
+// Mineflayer's `status: 2` "finish digging" was therefore sending
+// ABORT_DESTROY_BLOCK on 26.3. The server accepted START, then received
+// ABORT, and cancelled every dig - which is why its verdict log read
+// "actual start of destroying" immediately followed by "aborted destroying"
+// and no block ever broke. `status: 1` "cancel digging" was likewise landing
+// on CHANGE_DESTROY_DIRECTION, which does nothing.
+//
+// Named constants, not literals, so this cannot silently drift again.
+const DIG_STATUS = Object.freeze({
+  START: 0,
+  ABORT: 2,
+  STOP: 3
+})
+
 module.exports = inject
 
 function inject (bot) {
   let swingInterval = null
   let waitTimeout = null
+  // 26.3 REQUIRED FIELD. Verified against the protocol data shipped in
+  // node_modules/minecraft-data/data/pc/26.3/protocol.json:
+  //   packet_block_dig = container [ status:varint, location:position,
+  //                                 face:i8, sequence:varint ]
+  // `sequence` is NOT optional in 26.2 or 26.3. Stock mineflayer 4.37.1 omits
+  // it from all three writes (start / finish / cancel), so the packet stream
+  // desynchronises and the server silently ignores the dig.
+  //
+  // This replaces a hand-rewrite of this file that had grown to 519 lines
+  // (stock is 267) with six interlocking 26.3 workarounds - STOP-TIME, SEQ-
+  // TRUTH, FACE-SYNC, RESTOP, GHOST-BREAK, NOSWING - each added in response to
+  // a symptom. That version DID send a sequence and the server DID ack it, and
+  // still broke nothing: 594 stone digs, 0 blocks broken, "Collected 0" seven
+  // times. Only zero-hardness blocks ever fell. So the extra machinery was
+  // the problem, not the fix. Stock flow, plus the one field 26.3 requires.
+  let _digSeq = 0
+  const nextDigSeq = () => ++_digSeq
 
   let diggingTask = createDoneTask()
 
